{
  "name": "vector-cache-proxy",
  "version": "2.0.0",
  "description": "Semantic cache for LLM responses, backed by Redis vector search",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "vector",
    "cache",
    "redis",
    "llm",
    "semantic-cache",
    "semantic-search",
    "embedding",
    "ai"
  ],
  "author": "Dang Huynh <danghuynh.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haidang1810/vector-cache-proxy.git"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "ioredis": "^5.3.2"
  }
}
